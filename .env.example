# Drawing Coach environment variables
# Copy relevant lines to ~/.config/drawing-coach/.env and fill in your values.
# Real environment variables always take precedence over the .env file.

# API key for your LLM provider (OpenAI, Anthropic, etc.)
# Required unless using a local model that needs no key (e.g. Ollama).
DRAWING_COACH_API_KEY=

# LiteLLM model identifier — overrides the value saved in settings.
# Examples: gpt-4o, claude-opus-4-8, ollama/llava
# DRAWING_COACH_MODEL=

# Custom base URL for LiteLLM proxy, Ollama, or other OpenAI-compatible endpoints.
# Leave unset to use each provider's default endpoint.
# DRAWING_COACH_API_BASE=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Log verbosity level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL (case-insensitive)
# Default: WARNING (silent during normal operation)
# Set to INFO to see session directory path, API key status, and LLM call outcomes.
# Set to DEBUG for a full frame-by-frame trace.
# DRAWING_COACH_LOG_LEVEL=INFO

# Optional: write logs to a file in addition to stderr.
# The parent directory must exist. If unset, output goes to stderr only.
# DRAWING_COACH_LOG_FILE=/tmp/drawing-coach.log

# Maximum log file size in bytes before the file is rotated (default: 10485760 = 10 MB).
# When the file reaches this size, its contents are discarded and a new file begins,
# capping total disk usage to this limit. Requires DRAWING_COACH_LOG_FILE to be set.
# DRAWING_COACH_LOG_MAX_BYTES=10485760

# Optional: GUI-thread stall diagnostics. Off by default; costs nothing when off.
# Set to 1 (or on/true) to log what blocks the UI thread, or "full" to also arm
# the faulthandler fallback for stalls inside native code. Writes to
# <data dir>/debug_logs/perf.log unless DRAWING_COACH_LOG_FILE is set.
# See "Reporting a sluggish or frozen UI" in the README.
# DRAWING_COACH_PERF_WATCHDOG=1

# How long the UI must be blocked before it counts as a stall, in milliseconds.
# Default: 250. Only used when DRAWING_COACH_PERF_WATCHDOG is enabled.
# DRAWING_COACH_PERF_STALL_MS=250
