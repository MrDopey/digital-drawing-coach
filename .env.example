# Drawing Coach environment variables
# Copy relevant lines to ~/.config/drawing-coach/.env and fill in your values.
# Real environment variables always take precedence over the .env file.

# API key for your LLM provider (OpenAI, Anthropic, etc.)
# Required unless using a local model that needs no key (e.g. Ollama).
DRAWING_COACH_API_KEY=

# LiteLLM model identifier — overrides the value saved in settings.
# Examples: gpt-4o, claude-opus-4-8, ollama/llava
# DRAWING_COACH_MODEL=

# Custom base URL for LiteLLM proxy, Ollama, or other OpenAI-compatible endpoints.
# Leave unset to use each provider's default endpoint.
# DRAWING_COACH_API_BASE=
